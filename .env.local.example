# Copie ce fichier en `.env.local` puis remplis les valeurs.
#   cp .env.local.example .env.local
#
# Toute variable `NEXT_PUBLIC_*` est exposée au navigateur : n'y mets jamais de secret.

# --- Supabase (requis) -------------------------------------------------------
# Project Settings ▸ API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — SECRET, serveur uniquement.
# Utilisée seulement par `scripts/seed-demo.ts` (contourne la RLS pour semer les démos).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (requis) ------------------------------------------------------
# Lue implicitement par `@ai-sdk/anthropic` : jamais référencée dans le code,
# mais sans elle tous les appels LLM échouent.
ANTHROPIC_API_KEY=

# --- Webhook Make.com (requis pour /api/webhooks/inbound-email) --------------
# Secret partagé, comparé au header `x-webhook-secret`. Non défini, la route
# répond 500 : elle refuse de s'ouvrir plutôt que d'accepter n'importe qui.
WEBHOOK_SECRET=

# URL publique de l'app, utilisée dans les liens des mails sortants.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Génération de site de démo (optionnel) ---------------------------------
# Webhook appelé par /api/pipeline/generate. Non défini, la route répond 503
# et la génération de démo est simplement indisponible.
SITE_GENERATOR_WEBHOOK_URL=

# --- Rate limiting (optionnel) ----------------------------------------------
# `lib/rate-limit.ts` n'accorde sa confiance à `x-forwarded-for` que si cette
# variable est définie — sinon l'en-tête est ignoré (il est trivial à falsifier
# hors d'un proxy de confiance) et le quota retombe sur `x-real-ip`.
# À définir sur Vercel (n'importe quelle valeur non vide), à laisser vide en local.
TRUSTED_PROXY=

# --- Identité freelance affichée sur les devis PDF (optionnel) ---------------
NEXT_PUBLIC_FREELANCER_EMAIL=
NEXT_PUBLIC_FREELANCER_SIRET=
NEXT_PUBLIC_FREELANCER_PHONE=
NEXT_PUBLIC_FREELANCER_ADDRESS=
